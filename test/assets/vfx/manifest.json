{
  "version": 1,
  "pack": "hero_awakening_vfx",
  "project": "The Pixel Odyssey",
  "note": "주인공 3직업 각성기 4프레임 VFX. 모든 스트립은 가로 4개의 동일 셀(폭 = strip.width/4)로 정규화되어 있어 width/4 슬라이스로 잘라도 절대 클리핑되지 않는다. 각 셀의 내용은 좌우 여백 16px 이상, 하단 여백은 정확히 16px(=지면 접점)로 통일되어 있다.",
  "artRules": {
    "style": "16-bit dark fantasy pixel art, pure 2D orthographic side view",
    "background": "transparent RGBA",
    "floorRings": "none (no top-down / isometric / circular floor ellipse)",
    "slice": "img.width / 4 per frame",
    "imageSmoothing": false,
    "composite": "lighter (additive) over the stage"
  },
  "alignment": {
    "anchor": "bottom-center",
    "groundPad": 16,
    "cellWidth": "strip.width / 4",
    "cellHeight": "strip.height",
    "drawGroundY": "지면 y좌표 - (cellH - 16 * scale) 기준으로 셀을 그린다",
    "verticalAlign": "bottom (모든 프레임이 같은 지면선을 공유하도록 하단 정렬로 합성됨)"
  },
